{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "src/**",
      "migrations/**",
      "assets/**",
      "extension/**",
      "package.json",
      "package-lock.json",
      "tsconfig.json",
      "Dockerfile",
      ".dockerignore",
      "railway.json"
    ]
  }
}
