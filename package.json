{
  "name": "crosspoint-sync",
  "version": "0.1.0",
  "description": "Lightweight KOSync-compatible sync server for CrossPoint / CrossInk e-readers: reading progress, bookmarks, clippings, and reading stats.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "build:koreader": "npm run build && node scripts/package-koreader.mjs",
    "test:koreader": "lua koreader/tests/sync_test.lua",
    "release:koreader": "bash scripts/release-koreader.sh",
    "build:frontend": "npm ci --prefix app --ignore-scripts && npm run build --prefix app",
    "test": "vitest run --dir test",
    "test:watch": "vitest",
    "preversion": "npm test",
    "postversion": "git push --follow-tags && gh release create v$npm_package_version --generate-notes"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@xmldom/xmldom": "^0.9.12",
    "hono": "^4.6.16",
    "opentype.js": "^1.3.4",
    "pngjs": "^7.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "@types/yauzl": "^3.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
