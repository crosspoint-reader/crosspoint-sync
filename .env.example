# Local dev settings. Copy to .env (gitignored); `npm run dev` loads it.
# Every variable is documented in README.md under Configuration.

DATABASE_PATH=./data/crosspoint.db
PORT=8080

# Enables connectors (encrypts stored credentials). Any 64 hex chars:
#   openssl rand -hex 32
TOKEN_ENC_KEY=

# Docker localhost testing only: bind the published port to 127.0.0.1.
# ALLOW_HTTP_LOCALHOST=true

# Enable only behind an HTTPS reverse proxy that sets X-Forwarded-Proto,
# with direct access to Sync blocked. See README.md for Caddy setup.
# TRUST_PROXY=true

