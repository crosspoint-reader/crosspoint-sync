{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrossPoint Sync",
  "version": "0.1.0",
  "identifier": "com.crosspointreader.sync",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CrossPoint Sync",
        "width": 440,
        "height": 880,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 360,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "crosspointsync"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "crosspointsync"
        ]
      }
    }
  }
}
