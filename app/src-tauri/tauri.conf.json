{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrossPoint Sync",
  "version": "0.1.1",
  "identifier": "com.crosspointreader.sync",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CrossPoint Sync",
        "width": 440,
        "height": 880,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 360,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "versionCode": 1008
    },
    "iOS": {
      "minimumSystemVersion": "16.0",
      "developmentTeam": "96247QW4R8",
      "bundleVersion": "12"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "https"
          ],
          "host": "sync.crosspointreader.com",
          "pathPrefix": [
            "/connectors/spotify/callback"
          ],
          "appLink": true
        }
      ]
    }
  }
}
