<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark: the dark page colour. The in-app Appearance setting picks
         light/dark per app (UiModeManager), which also selects values-night. -->
    <style name="Theme.crosspoint_sync_app" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/paper_dark</item>
        <item name="android:statusBarColor">@color/paper_dark</item>
        <item name="android:navigationBarColor">@color/paper_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Android 12+ system splash: launcher icon on the page colour. -->
        <item name="android:windowSplashScreenBackground">@color/paper_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>
</resources>
